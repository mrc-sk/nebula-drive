# 默认按文本处理，检出时统一转 LF、提交时统一转 LF
* text=auto eol=lf

# Windows 专用脚本： CRLF 是对的（.bat 靠\r\n 正确解析）
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须是 LF —— CRLF 会导致 Linux 报
# "bad interpreter: /bin/sh^M"，是发给别人试用时最容易踩的坑
*.sh text eol=lf

# 二进制：禁止任何行尾转换与 diff
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.db binary

# 语言统计用的默认标记
*.go linguist-language=Go
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.md linguist-documentation
