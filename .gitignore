# NebulaDrive 后端运行产物
backend/nebula
backend/nebula.exe
backend/data/
backend/data.db
backend/*.db
backend/*.log
# 敏感文件：密钥、前端依赖产物、本地设置
backend/data/secret.key
backend/data/*.ini
backend/data/*.json

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
# tsc -b 从 vite.config.ts 生成的产物（构建时自动再生，不应进库）
frontend/vite.config.js
frontend/vite.config.d.ts
# tsc -b 增量时间戳垃圾文件
frontend/vite.config.js.timestamp-*.mjs
*.timestamp-*.mjs

# 测试运行产物
# 测试里 ensureDefaultPolicy 用的是相对路径 "uploads"，会在各包的测试工作目录下
# 真的建出 uploads/ 目录。属于运行产物，不应进版本库。
backend/controllers/uploads/
backend/filesystem/uploads/

# 交叉编译暂存目录（Git Bash 的 /tmp 对 Go 工具链不可见，只能落在这里）
backend/.ndbuild/
# 冒烟测试临时目录（跑发布产物时用，会建 sqlite 库与截图）
backend/.smoke/
# gofmt 行尾归一化检测的临时目录
backend/.fmtcheck/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
coverage.out

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# nfpm
*.deb
*.rpm
*.apk

# 发布包（含几十 MB 的单二进制，不应进版本库）
release/
