# NebulaDrive 后端运行产物
backend/nebula
backend/nebula.exe
backend/data/
backend/data.db
backend/*.db
backend/*.log
# 敏感文件：密钥、前端依赖产物、本地设置
backend/data/secret.key
backend/data/*.ini
backend/data/*.json

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
# tsc -b 从 vite.config.ts 生成的产物（构建时自动再生，不应进库）
frontend/vite.config.js
frontend/vite.config.d.ts
# tsc -b 增量时间戳垃圾文件
frontend/vite.config.js.timestamp-*.mjs
*.timestamp-*.mjs

# 测试运行产物
# 测试里 ensureDefaultPolicy 用的是相对路径 "uploads"，会在各包的测试工作目录下
# 真的建出 uploads/ 目录。属于运行产物，不应进版本库。
backend/controllers/uploads/
backend/filesystem/uploads/

# 交叉编译暂存目录（Git Bash 的 /tmp 对 Go 工具链不可见，只能落在这里）
backend/.ndbuild/
# 冒烟测试临时目录（跑发布产物时用，会建 sqlite 库与截图）
backend/.smoke/
# 冒烟脚本的临时产物：正常退出由 trap 清理，被 Ctrl+C / kill 中断时会残留
# （数据目录里有真实 SQLite 库，不忽略就有被误提交的风险）
backend/.smoke-nebula
backend/.smoke-nebula.exe
backend/.smoke-plugindata/
backend/.smoke-policydata/
# gofmt 行尾归一化检测的临时目录
backend/.fmtcheck/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
coverage.out

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# nfpm
*.deb
*.rpm
*.apk

# 发布包（含几十 MB 的单二进制，不应进版本库）
release/

# 打包工具产物
#
# tools/ 只放构建结果（pbclus-pack 可执行文件、试打的 .pbclus 包），
# 源码在 backend/cmd/pbclus-pack/。可执行文件本来就由上面的 *.exe 覆盖，
# 这里额外挡一下 .pbclus —— 它是产物，不该被当成"示例包"提交进来。
tools/

# 运行产物（真实数据库、密钥、上传文件 —— plugins 分支曾因此泄露，见 FIXLOG）
record_run/
guide/shots/
guide/build/

# 发布素材（200MB+ 的 mp4/png/wav/ttc，不该进 git）
*.mp4
*.ttc
*.wav
guide/
backend/data.bak.*/
backend/uploads/


# V26-11.1：交付资产的运行产物与密钥（不入库）
__pycache__/
*.pyc
official-plugins/official-signing-key.json
wiki-site/.build-cache/
